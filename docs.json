{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Vizluma API",
  "description": "Vizluma 开发文档：GPT、Claude、图像与视频模型、SDK 接入、异步任务和计费参考",
  "logo": {
    "light": "/images/vizluma-symbol-v1.png",
    "dark": "/images/vizluma-symbol-v1.png",
    "href": "/"
  },
  "favicon": "/images/vizluma-symbol-v1.png",
  "colors": {
    "primary": "#4F46E5",
    "light": "#818CF8",
    "dark": "#6366F1"
  },
  "navbar": {
    "links": [
      {
        "label": "官网",
        "href": "https://vizluma.online"
      },
      {
        "label": "控制台",
        "href": "https://vizluma.online/console"
      }
    ]
  },
  "api": {
    "mdx": {
      "server": "https://api.vizluma.online"
    },
    "playground": {
      "display": "none"
    },
    "examples": {
      "autogenerate": false
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "接入指南",
